# Copiar este archivo como .env (cp .env.example .env) y completar los valores locales.
# NUNCA versionar el .env: puede contener contraseñas reales.
#
# Configuracion COMUN a los tres nodos. Lo que distingue a cada nodo (puertos, base
# de datos, peers) sale de cluster.json segun el --node con el que se arranca.

# Certificado HTTPS de la API externa (generado con scripts/generar-certificado.ps1).
# Si el archivo no existe, cada nodo arranca igual pero solo con HTTP.
SSL_PFX_PATH=./certs/server.pfx
SSL_PASSPHRASE=cambiar_esto

# MongoDB: un mismo servidor, una base distinta por nodo (<prefijo><nodo>):
#   tp4_nodo1, tp4_nodo2, tp4_nodo3. El nombre de base que venga en la URI se ignora.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_PREFIX=tp4_
# Alternativa: MongoDB Atlas (ver README)
# MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Si el DNS local no resuelve los registros SRV de Atlas (error "querySrv ETIMEOUT"):
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Redis / Memurai: SOLO para el lock de la compra (heredado del TP2).
# No participa de la eleccion, los votos, el quorum ni el commit de Raft.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Lock de exclusion mutua. Tiene que cubrir lectura + delay + commit Raft.
LOCK_TTL_MS=10000

# Delay artificial dentro de la seccion critica de la compra (ms)
COMPRA_DELAY_MS=300

# Raft
# Election timeout aleatorio en [MIN, MAX] (se sortea de nuevo en cada reinicio del timer)
RAFT_ELECTION_TIMEOUT_MIN_MS=3000
RAFT_ELECTION_TIMEOUT_MAX_MS=6000
# Intervalo de heartbeats del Leader (tiene que ser bastante menor al MIN de arriba)
RAFT_HEARTBEAT_MS=1000
# Timeout de cada RPC entre nodos
RAFT_RPC_TIMEOUT_MS=1500
# Cuanto espera el Leader el commit de una escritura antes de responder 503 sin quorum
RAFT_COMMIT_TIMEOUT_MS=5000
# Maximo de entradas por AppendEntries (recuperacion de followers atrasados)
RAFT_MAX_ENTRADAS_POR_MENSAJE=50

# Logging (Winston). Cada nodo escribe en LOG_DIR/<nodo>/
LOG_DIR=logs
# info muestra elecciones, commits, replicacion, etc. debug agrega cada heartbeat.
LOG_LEVEL=info
LOG_MAX_SIZE=20m
LOG_MAX_FILES=14d

# Opcionales (normalmente no hace falta definirlas)
# NODE_ENV=production          # desactiva el log por consola (solo archivos)
# CLUSTER_CONFIG=./cluster.json # ruta alternativa a la configuracion del cluster
# API_BASE_URL=http://127.0.0.1:3001  # test-concurrencia: apuntar a un nodo fijo en vez de buscar al Leader
