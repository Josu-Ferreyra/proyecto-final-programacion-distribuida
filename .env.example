# Variables opcionales para docker compose: todas tienen valor por defecto en compose.yml,
# así que este archivo solo hace falta para cambiarlas. No contiene secretos.
# Compose lee automáticamente el .env de la raíz: no dejar ahí el .env de app-base/.

# Nivel de logs de todos los servicios: error, warn, info, debug
LOG_LEVEL=info

# RAFT_COMMIT_TIMEOUT_MS no se configura acá a propósito: está fijo en 2500 en
# compose.yml porque tiene que ser menor que los 3000 ms que Ventas espera a Inventario
# (decisión D3 de docs/08-ratificacion-tp6.md).
