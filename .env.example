# Copiar como .env en la raíz (no se versiona): cp .env.example .env
# Docker Compose lo lee solo. Los valores de acá son FICTICIOS: cambiarlos antes de levantar.
# Si en la raíz quedó el .env del TP4 (app-base/), moverlo: Compose usaría ese en lugar de este.

# Secreto HS256 de los JWT (D9, D16): el mismo para auth-service, Catálogo, Inventario y Ventas.
# Obligatorio y de al menos 32 caracteres. Generar uno:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=cambiar-por-un-secreto-aleatorio-de-al-menos-32-caracteres

# Vencimiento del access token (para la prueba del token vencido se puede bajar a 30s)
JWT_EXPIRES_IN=15m

# Primer ADMIN, lo crea auth-service al arrancar si no existe (D11). La password es obligatoria.
ADMIN_EMAIL=admin@tp7.local
ADMIN_PASSWORD=cambiar-esta-password

# Cuenta técnica de Ventas (rol SERVICIO, D13); el email es fijo: ventas@servicio.local
VENTAS_SERVICE_PASSWORD=cambiar-esta-otra-password

# Nivel de logs de todos los servicios: error, warn, info, debug
LOG_LEVEL=info

# RAFT_COMMIT_TIMEOUT_MS no se configura acá a propósito: está fijo en 2500 en
# compose.yml porque tiene que ser menor que los 3000 ms que Ventas espera a Inventario
# (decisión D3 de docs/08-ratificacion-tp6.md).
