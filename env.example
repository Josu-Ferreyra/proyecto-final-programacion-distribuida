# =============================================================================
# TP4 - API REST Distribuida + Raft
# Archivo de ejemplo de configuración.
#
# Copiar este archivo como ".env" y ajustar únicamente los valores locales.
# NO versionar ni entregar el archivo .env real.
# =============================================================================


# -----------------------------------------------------------------------------
# Entorno general
# -----------------------------------------------------------------------------

NODE_ENV=development

HOST=127.0.0.1
API_PREFIX=/api
JSON_LIMIT=100kb


# -----------------------------------------------------------------------------
# API HTTP
#
# Los puertos se utilizan como base:
# node1 -> 3000
# node2 -> 3001
# node3 -> 3002
# -----------------------------------------------------------------------------

HTTP_ENABLED=true
HTTP_PORT=3000


# -----------------------------------------------------------------------------
# API HTTPS
#
# Los puertos se utilizan como base:
# node1 -> 3443
# node2 -> 3444
# node3 -> 3445
#
# IMPORTANTE:
# El PFX real y su contraseña NO deben incluirse en la entrega.
# Cada entorno debe proporcionar su propio certificado.
# -----------------------------------------------------------------------------

HTTPS_ENABLED=true
HTTPS_PORT=3443
HTTPS_PFX_PATH=./certs/server.pfx
HTTPS_PFX_PASSPHRASE=CAMBIAR_LOCALMENTE


# -----------------------------------------------------------------------------
# MongoDB
#
# Cada nodo utiliza una base independiente construida a partir del prefijo:
#
# node1 -> tp4_node1
# node2 -> tp4_node2
# node3 -> tp4_node3
# -----------------------------------------------------------------------------

MONGODB_BASE_URI=mongodb://127.0.0.1:27017
MONGODB_DB_PREFIX=tp4


# -----------------------------------------------------------------------------
# Redis / Memurai
#
# Se utiliza para exclusión mutua distribuida.
# NO participa en elecciones, votos, quorum, replicación ni commit de Raft.
# -----------------------------------------------------------------------------

REDIS_URL=redis://127.0.0.1:6379


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

LOG_LEVEL=info
LOG_DIR=./logs
LOG_MAX_SIZE=5m
LOG_MAX_FILES=7d


# -----------------------------------------------------------------------------
# Raft - Election
#
# Los election timeouts son aleatorios dentro de este rango.
# Deben ser claramente mayores que el intervalo de heartbeat.
# -----------------------------------------------------------------------------

RAFT_ELECTION_TIMEOUT_MIN_MS=2500
RAFT_ELECTION_TIMEOUT_MAX_MS=4500


# -----------------------------------------------------------------------------
# Raft - RPC
# -----------------------------------------------------------------------------

RAFT_RPC_TIMEOUT_MS=1500


# -----------------------------------------------------------------------------
# Raft - Heartbeat / Replicación
#
# El heartbeat debe ser sensiblemente menor al election timeout mínimo.
# -----------------------------------------------------------------------------

RAFT_HEARTBEAT_INTERVAL_MS=700
RAFT_REPLICATION_RPC_TIMEOUT_MS=700
