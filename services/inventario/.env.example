# Copiar como .env (cp .env.example .env) para correr con `npm start`.
# En Docker Compose estas variables las define compose.yml y el .env no se usa.
# No contiene secretos: la base y Redis locales no tienen usuario ni contraseña.
#
# Las variables propias de cada nodo (RAFT_NODO_ID y MONGODB_URI) las pisa
# scripts/iniciar-local.ps1 al levantar los 3 nodos: las variables del proceso tienen
# prioridad sobre el .env.

SERVICE_NAME=inventario-service
LOG_LEVEL=info

# Identidad del nodo y topología del cluster.
#   local:  CLUSTER_FILE=cluster.local.json   (puertos 3201-3203, Raft 4201-4203)
#   Compose: CLUSTER_FILE=cluster.docker.json (puerto 3200, Raft 4200)
RAFT_NODO_ID=inventario-1
CLUSTER_FILE=cluster.local.json
# PORT es opcional: si se define tiene que coincidir con el apiHttpPort del nodo.
# PORT=3201

# Una base por nodo (D2). En Compose: mongodb://inventario-db:27017/inventario_nodo1
MONGODB_URI=mongodb://127.0.0.1:27017/inventario_nodo1

# Catálogo (contrato C4, solo en el alta de stock). En Compose: http://catalogo-service:3100
CATALOGO_SERVICE_URL=http://localhost:3100
HTTP_TIMEOUT_MS=3000

# Lock interno (Memurai en Windows, Redis en Compose). En Compose: redis://redis:6379
REDIS_URL=redis://127.0.0.1:6379
LOCK_TTL_MS=5000
# Cuánto espera un pedido a que se libere el lock de un producto antes de responder 409
LOCK_WAIT_MS=400

# Raft. D3: el commit tiene que fallar antes que el timeout de 3000 ms de Ventas.
RAFT_COMMIT_TIMEOUT_MS=2500
RAFT_ELECTION_TIMEOUT_MIN_MS=3000
RAFT_ELECTION_TIMEOUT_MAX_MS=6000
RAFT_HEARTBEAT_MS=1000
RAFT_RPC_TIMEOUT_MS=1500

# JWT (TP7, D9 y D16 de docs/14-modelo-seguridad.md). El mismo JWT_SECRET que auth-service y los
# demás servicios: en Compose sale del .env de la raíz. Valor ficticio: generá uno con
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# El servicio no arranca si falta o tiene menos de 32 caracteres.
JWT_SECRET=cambiar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_ISSUER=auth-service

# Opcionales
# DESCUENTO_DELAY_MS=0          # demora artificial dentro del descuento (pruebas de fallos)
# MONGODB_CONNECT_RETRIES=10    # intentos de conexión a Mongo al arrancar
# MONGODB_RETRY_MS=3000         # espera entre intentos
# NODE_ENV=production           # logs en JSON (así corre la imagen Docker)
