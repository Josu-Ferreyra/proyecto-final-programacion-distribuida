# Copiar como .env (cp .env.example .env) para correr con `npm start`.
# En Docker Compose estas variables las define compose.yml (los secretos salen del .env de la raíz).
# Todos los valores de acá son FICTICIOS: cambiarlos antes de usar.

# Nombre del servicio en los logs, en /health y en el campo "servicio" de los errores
SERVICE_NAME=auth-service

# Puerto HTTP de la API (convención del TP7: auth-service = 3400)
PORT=3400

# Base propia del servicio. En Compose: mongodb://auth-db:27017/auth
MONGODB_URI=mongodb://127.0.0.1:27017/auth

# JWT (D9 y D16 de docs/14-modelo-seguridad.md). El mismo JWT_SECRET en los 4 servicios.
# El servicio no arranca si falta o tiene menos de 32 caracteres. Generar uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=cambiar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_ISSUER=auth-service
# Vencimiento del access token: 15m. Para probar el token vencido se puede bajar a 30s.
JWT_EXPIRES_IN=15m

# Costo de bcrypt (10 a 15)
BCRYPT_ROUNDS=12

# Cuentas que se crean al arrancar si no existen (D11). Si faltan, el servicio arranca igual.
ADMIN_EMAIL=admin@tp7.local
ADMIN_PASSWORD=cambiar-esta-password
VENTAS_SERVICE_EMAIL=ventas@servicio.local
VENTAS_SERVICE_PASSWORD=cambiar-esta-otra-password

# Nivel de Winston: error, warn, info, debug
LOG_LEVEL=info

# Opcionales
# MONGODB_CONNECT_RETRIES=10   # intentos de conexión a Mongo al arrancar
# MONGODB_RETRY_MS=3000        # espera entre intentos
# NODE_ENV=production          # logs en JSON (así corre la imagen Docker)
