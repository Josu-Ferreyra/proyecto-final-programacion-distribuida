# Copiar como .env (cp .env.example .env) para correr con `npm start`.
# En Docker Compose estas variables las define compose.yml y el .env no se usa.
# No contiene secretos: la base local no tiene usuario ni contraseña.

# Nombre del servicio en los logs, en /health y en el campo "servicio" de los errores
SERVICE_NAME=ventas-service

# Puerto HTTP de la API (convención del TP6: Ventas = 3300)
PORT=3300

# Base propia del servicio. En Compose: mongodb://ventas-db:27017/ventas
MONGODB_URI=mongodb://127.0.0.1:27017/ventas

# Catálogo (contrato C1). En Compose: http://catalogo-service:3100
CATALOGO_SERVICE_URL=http://localhost:3100

# Inventario (contratos C2 y C3). Local: cualquiera de los 3 nodos (los followers
# reenvían al Leader, D1). En Compose: http://inventario-service:3200 (alias de los 3 nodos)
INVENTARIO_SERVICE_URL=http://localhost:3201

# Timeout de cada llamada a otro servicio (TP5 §6: 3 s)
HTTP_TIMEOUT_MS=3000

# Cada cuánto se reintentan los reintegros pendientes: cancelaciones en
# CANCELACION_PENDIENTE y compras FALLIDA con reintegro pendiente (D7)
REINTENTO_REINTEGRO_MS=30000

# Nivel de Winston: error, warn, info, debug
LOG_LEVEL=debug

# Opcionales
# MONGODB_CONNECT_RETRIES=10   # intentos de conexión a Mongo al arrancar
# MONGODB_RETRY_MS=3000        # espera entre intentos
# NODE_ENV=production          # logs en JSON (así corre la imagen Docker)
